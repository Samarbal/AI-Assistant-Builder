DATABASE_URL=postgresql+psycopg://assistant_runtime:PASSWORD@HOST:5432/postgres?sslmode=require
# Provide only to the migration process, not the deployed FastAPI process.
MIGRATION_DATABASE_URL=postgresql+psycopg://MIGRATION_USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Percent-encode reserved characters in URL credentials. Copy pooler usernames
# from the provider; current_user must still resolve to assistant_runtime.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-only secret or legacy service_role key. Never use in Swagger/client code.
SUPABASE_STORAGE_KEY=
SUPABASE_STORAGE_BUCKET=knowledge-files
STORAGE_SIGNED_URL_SECONDS=60
ENVIRONMENT=development
