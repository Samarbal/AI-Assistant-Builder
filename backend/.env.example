DATABASE_URL=postgresql+psycopg://assistant_runtime:PASSWORD@HOST:5432/postgres?sslmode=require
# Public chat is disabled by default. If enabling a supervised demo, use only the
# separate restricted login and never substitute DATABASE_URL or a service role.
PUBLIC_CHAT_ENABLED=false
# PUBLIC_DATABASE_URL=postgresql+psycopg://assistant_public_runtime:PASSWORD@HOST:5432/postgres?sslmode=require
# Up to two SHA-256 digests for separately shared demo access tokens; never put raw tokens here.
# PUBLIC_DEMO_TOKEN_SHA256=
# Demo-process limits: per-IP/public assistant rate, per-assistant concurrency, global concurrency.
PUBLIC_RATE_LIMIT_PER_MINUTE=30
PUBLIC_MAX_CONCURRENT=2
PUBLIC_GLOBAL_MAX_CONCURRENT=4
PUBLIC_RATE_KEY_CAPACITY=4096
# Exact origin that serves frontend widget.js and /widget; CORS applies only to public chat.
# WIDGET_ASSET_ORIGIN=https://app.example.com
# Provide only to the migration process, not the deployed FastAPI process.
MIGRATION_DATABASE_URL=postgresql+psycopg://MIGRATION_USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Percent-encode reserved characters in URL credentials. Copy pooler usernames
# from the provider; current_user must still resolve to assistant_runtime.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-only secret or legacy service_role key. Never use in Swagger/client code.
SUPABASE_STORAGE_KEY=
SUPABASE_STORAGE_BUCKET=knowledge-files
STORAGE_SIGNED_URL_SECONDS=60
ENVIRONMENT=development
# Server-side generation only. Not consumed by any endpoint yet.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_SECONDS=12

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=768

# Runtime embedding adapter: independent of AI_* generation settings.
# OPENAI_* above are validation-script settings, not runtime aliases.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=768
EMBEDDING_TIMEOUT_SECONDS=12
EMBEDDING_MAX_BATCH_SIZE=8
EMBEDDING_MAX_INPUT_TOKENS=4800
# Initial threshold from the synthetic bilingual Phase 3 calibration fixtures.
# Recalibrate when the embedding model or representative corpus changes.
RETRIEVAL_MIN_SIMILARITY=0.534433
